generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WindowType {
  casement
  awning
  tilt_turn
  sliding

  @@map("window_type")
}

enum OrderStatus {
  new
  in_progress
  completed

  @@map("order_status")
}

enum PaymentStatus {
  pending
  requires_action
  requires_capture
  processing
  succeeded
  canceled
  failed
  disputed

  @@map("payment_status")
}

enum WebhookProcessingStatus {
  processing
  processed
  failed

  @@map("webhook_processing_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contractor Contractor?

  @@map("users")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  clientName String      @map("client_name")
  address    String
  windowType WindowType  @map("window_type")
  width      Float
  height     Float
  status     OrderStatus @default(new)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  payment Payment?

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Contractor {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  stripeAccountId  String   @unique @map("stripe_account_id")
  chargesEnabled   Boolean  @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean  @default(false) @map("payouts_enabled")
  detailsSubmitted Boolean  @default(false) @map("details_submitted")
  requirementsDue  String[] @default([]) @map("requirements_due")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("contractors")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @map("order_id") @db.Uuid
  contractorId         String        @map("contractor_id") @db.Uuid
  stripePaymentIntentId String       @unique @map("stripe_payment_intent_id")
  stripeChargeId       String?       @unique @map("stripe_charge_id")
  idempotencyKey       String        @unique @map("idempotency_key")
  amount               Int
  applicationFeeAmount Int           @map("application_fee_amount")
  currency             String
  status               PaymentStatus @default(pending)
  authorizedAt         DateTime?     @map("authorized_at")
  capturedAt           DateTime?     @map("captured_at")
  canceledAt           DateTime?     @map("canceled_at")
  disputeId            String?       @unique @map("dispute_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([contractorId])
  @@map("payments")
}

model WebhookEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  stripeEventId String                  @unique @map("stripe_event_id")
  type          String
  status        WebhookProcessingStatus @default(processing)
  attempts      Int                     @default(1)
  processedAt   DateTime?               @map("processed_at")
  lastError     String?                 @map("last_error")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("webhook_events")
}
